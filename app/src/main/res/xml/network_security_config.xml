<?xml version="1.0" encoding="utf-8"?>
<!--
    Trade-off explanation:
    AdGuard Home commonly runs on self-hosted local LAN nodes (e.g. Raspberry Pi) accessed
    directly via local IPv4/IPv6 addresses (192.168.x.x, 10.x.x.x) or mDNS hostnames (*.local).
    Android NetworkSecurityConfig <domain> elements only match exact hostnames/subdomains
    and do not natively support IP CIDR mask notation (like 192.168.0.0/16).
    Therefore, base-config permits cleartext traffic for LAN HTTP connections while
    ensuring standard system/user certificate trust anchors.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Specific local and mDNS domain scopes -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">local</domain>
        <domain includeSubdomains="true">lan</domain>
        <domain includeSubdomains="true">home</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
